# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# AI Provider Selection: "gemini" or "ollama" (defaults to gemini if unset/invalid)
AI_PROVIDER=gemini

# Google AI Configuration (used when AI_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration (used when AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ZeroTwo Personality Configuration (Optional - Default included)
# ZEROTWO_PERSONALITY_PROMPT=Your custom personality prompt here

# Random Message Configuration (Optional)
# Chance (0-100) that ZeroTwo will send a random message when someone talks in an activated channel
RANDOM_MESSAGE_CHANCE=5
