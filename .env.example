# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# AI Provider Selection: "gemini" or "ollama" (defaults to gemini if unset/invalid)
AI_PROVIDER=gemini

# Google AI Configuration (used when AI_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration (used when AI_PROVIDER=ollama)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# ZeroTwo Personality Configuration (Optional - Default included)
# ZEROTWO_PERSONALITY_PROMPT=Your custom personality prompt here

# Random Message Configuration (Optional)
# Chance (0-100) that Zero Two replies to a message in a channel where she is not activated. 0 turns this off.
RANDOM_MESSAGE_CHANCE=5

# Random DM Configuration (Optional)
# Now and then, Zero Two sends a DM to a user who is active in a server with her.
RANDOM_DM_ENABLED=true
# Minimum hours between two random DMs
RANDOM_DM_MIN_HOURS=6
# Minimum hours before the same user gets another random DM
RANDOM_DM_USER_COOLDOWN_HOURS=72
