{
  "name": "zerotwo-discord-bot",
  "version": "1.0.0",
  "description": "ZeroTwo from Darling in the FranXX - Discord AI Bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "dev:gemini": "tsc && cross-env AI_PROVIDER=gemini node dist/index.js",
    "dev:ollama": "tsc && cross-env AI_PROVIDER=ollama node dist/index.js"
  },
  "keywords": ["discord", "bot", "zerotwo", "gemini", "ollama", "ai"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3"
  }
}
